+  fieldRow('StatLabel', 48, { max_lines: triple(2, 'probe_calibrated') }),
+  fieldRow('ContextLine', 160),
+  fieldRow('CtaText', 90),
+];
+
+const TEMPLATE_ID = 'a3d8472d-0000-0000-0000-000000000001';
+const PROVIDER_ID = 'c11bb8ab-18bd-45ff-aedd-0a59cb3773ab';
+
